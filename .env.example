# Copier ce fichier en .env et adapter les valeurs avant de lancer docker compose

DB_ROOT_PASSWORD=change-me-root
DB_NAME=reimbursement
DB_USER=reimburse
DB_PASSWORD=change-me
APP_PORT=80

# URL publique de l'application, utilisée dans le lien envoyé par e-mail à maman
APP_BASE_URL=https://remboursement.trovic.ovh

# SMTP pour l'envoi de l'e-mail d'invitation de maman (laisser SMTP_HOST vide
# pour désactiver l'envoi : le lien d'invitation sera alors affiché dans
# l'interface pour que Victor le transmette lui-même)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Suivi remboursement <no-reply@trovic.ovh>
